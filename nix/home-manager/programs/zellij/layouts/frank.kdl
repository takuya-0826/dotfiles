// Frank - 採用AI秘書 (Python uv monorepo, backend中心)
//   起動: zj-project frank
//
// ┌──────────────────────┬────────────────────┐
// │ lead (claude, 55%)   │ frank.main :8080   │
// │                      ├────────────────────┤
// │                      │ front (予定地)     │
// └──────────────────────┴────────────────────┘
//
// ============================================================================
// このディレクトリの PJ レイアウト共通の設計メモ (2026-08-11)
// ============================================================================
//
// ■ 形: タブ = プロジェクト / ペイン = そのPJ内の役割
//
//   1 画面を 8 分割して 4 PJ を並べる「固定8席の dev-hub」は 2026-07-13 に
//   捨てた形であり、2026-08-11 に正式退役させた (_archived/dev-hub.kdl)。
//   PJ をペインに焼き込むと (a) PJ が増減・移動するたびにレイアウト改修が要る
//   (実際 wevox-ats のパス消失で 2 回踏んだ) (b) 使わない PJ の席も常に確保する
//   (c) 1 ペインが横 1/4 幅で claude の UI に狭い、の 3 つを同時に抱える。
//   まるちゃんの work.kdl も「タブ = PJ、1 タブに claude 1 枚」で、1 画面に
//   複数 PJ を並べたペインは 1 つも無い。
//
// ■ lead ペインは `claude-resume-latest --tab <TabName> <dir>` + start_suspended
//
//   - claude-resume-latest: そのディレクトリの直近セッションを session-id 明示で
//     --resume する。zellij セッションが消えても会話は ~/.claude/projects/ に
//     残るので、復元源は常にこちら。**zellij の復元ダンプは信用しない**
//     (zellij は `ps -ao ppid,args` で最も深い子を掴むため、claude ペインは必ず
//     MCP サーバ npm / node として保存される。2026-08-11 に dev-hub の実ダンプで
//     上段が npm / node に化け、素シェル 4 枚が command="claude" になっていた)。
//   - --tab: hook 用のタブ名登録。これが無いと 🤖 / ✅ のタブ名切り替えが
//     動かない (旧レイアウトは `command "claude"` 直呼びで、導入以来ずっと
//     無効だった)。
//   - start_suspended: 開いた時点では起動せず Enter 待ち。zellij は `command`
//     付きペインのコマンドが終了すると入力を受け付けない状態で固まるため、
//     即時実行だと resume に失敗した時点でそのペインが死ぬ。suspended なら
//     同じペインの中で何度でも Enter で再試行できる。加えて「レイアウトを
//     開いた瞬間」ではなく「Enter を押した瞬間」の最新セッションを掴む。
//
// ■ dev server ペインは従来どおり自動起動 (suspended にしない)
//
//   タブを開く = その PJ で作業する、なので server は立っていてほしい。
//   終了して固まったら Enter で再実行 (Ctrl+c で閉じる)。
//   サーバ起動を claude に頼まず人間がこのペインで直接動かすのは従来の運用どおり。
// ============================================================================
//
// UIは apps/frank-web を新設予定。作成後、下の "front" ペインを dev 起動に差し替える。
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }
    tab name="Frank" {
        pane split_direction="vertical" {
            pane name="lead" focus=true size="55%" cwd="/Users/takuyamatsumoto/Atrae/frank" {
                command "claude-resume-latest"
                args "--tab" "Frank" "/Users/takuyamatsumoto/Atrae/frank"
                start_suspended true
            }
            pane split_direction="horizontal" size="45%" {
                // Slack + HTTP(:8080) + ARQ を1プロセスで起動
                pane name="frank.main :8080" cwd="/Users/takuyamatsumoto/Atrae/frank" {
                    command "bash"
                    args "-c" "source .venv/bin/activate && exec python -m frank.main"
                }
                // frank-web 予定地。当面は作業用シェル(cwd=frankルート)。
                // redis が必要なら Alt+n で: redis-server
                pane name="front (apps/frank-web 予定)" cwd="/Users/takuyamatsumoto/Atrae/frank"
            }
        }
    }
}

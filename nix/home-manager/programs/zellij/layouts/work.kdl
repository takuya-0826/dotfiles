// work.kdl — メインの開発レイアウト (タブ = プロジェクト)
//   起動: zellij --layout work
//
// ┌─ Frank ─ tiki-taka ─ Forms ─ uSketch ─ brain ─ dotfiles ─┐
// │                                                                       │
// │  ┌─────────────────────────────────────────────────┐                  │
// │  │ claude-zellij "<TabName>" ... -c                │ ← expanded       │
// │  ├─────────────────────────────────────────────────┤                  │
// │  │ dev server (あれば)                             │ ← stacked        │
// │  └─────────────────────────────────────────────────┘                  │
// └───────────────────────────────────────────────────────────────────────┘
//
// ============================================================================
// 2026-10-07 追記: herdr → zellij 復帰 (上流 EdV4H 2026-10-05 に追従)
// ============================================================================
//
//   _archived/layouts/work.kdl を戻し、herdr 期 (2026-10-01) に決めた PJ 構成に揃えた:
//     確定 3 つ: Frank / tiki-taka / uSketch
//     常設:      dotfiles / brain
//     期間限定:  Forms (Survey→Forms 移行、2026-10 完了予定。終わったら外す)
//     外した:    Home (cockpit の scratch で代替) / ATS (wevox-hiring-sandbox へ移行中)
//   上流と同じく claude から --dangerously-skip-permissions を外した。
//   以下の設計メモは 2026-08-13 時点のもの (8 タブ前提の記述は当時のまま)。
//
// ============================================================================
// 設計メモ (2026-08-13)
// ============================================================================
//
// ■ 上流 EdV4H/dotfiles の work.kdl を、拓也の PJ に差し替えたもの
//
//   まるちゃんは 2 枚を使い分けている (本人の docs/terminal/zellij-layouts.md):
//     - work.kdl    = 「メインの開発レイアウト」。タブ = PJ、そこに座って打つ
//     - cockpit.kdl = 「4x2 グリッドの指揮レイアウト」。ペイン = PJ、
//                      claude は --remote-control 付きで、外から指示を流して
//                      動いている様子を眺める盤面
//
//   ⚠️ 2026-08-11 に「まるちゃんも 1 画面に複数 PJ を並べたペインは 1 つも無い」
//   と判断して dev-hub を退役させたが、これは work.kdl しか見ていなかった誤り。
//   cockpit.kdl はまさにペイン = PJ をやっている。ただし用途が「作業」ではなく
//   「指揮・俯瞰」なので、8 分割と タブ = PJ は対立しない。cockpit 相当は
//   cockpit.kdl として同日に起こした。どちらも auto-start では開かず、
//   使うときに `zellij --layout work` / `--layout cockpit` を手で打つ
//   (上流と同じ形。2026-08-14 拓也判断)。
//
// ■ cwd は固定 (まるちゃん通り)
//
//   彼の work.kdl は 2026-03-17 以降 5 ヶ月間 1 度も編集されていない = PJ 集合が
//   動かないので固定コストがゼロ。拓也の PJ はもっと動くが、生成方式や
//   オンデマンド方式より「ファイル 1 枚を見れば全部分かる」を優先した (拓也判断)。
//   PJ の増減時は この KDL を直して
//   `nix run nixpkgs#home-manager -- switch --flake .#myHomeConfig`。
//
// ■ タブは 8 個に絞る
//
//   claude の実績 (~/.claude/projects/ の cwd 別ディレクトリ) で選んだ。
//   落としたもの: Frank-v2 (worktree = 消える前提。並行実装の分離は
//   `Agent(isolation: worktree)` で都度作る) / ~/Atrae (frank・ATS・Forms・
//   uSketch の親。専用の席を常に確保する性質ではない)。
//
// ■ 全ペイン start_suspended true (まるちゃん通り)
//
//   8 タブが同時起動するとリソースが持たない。加えて zellij は `command` 付き
//   ペインのコマンドが終了すると入力を受け付けない状態で固まるため、即時実行だと
//   起動に失敗した時点でそのペインが死ぬ。suspended なら Enter で何度でも再試行
//   できる。dev server も suspended にしてある (旧 zj-project 系は自動起動だった)。
//
// ■ 会話の継続は claude の -c だけが担う
//
//   まるちゃんは zellij の config.kdl 自体を持たない = session_serialization は
//   デフォルトの false。「セッションは使い捨て、レイアウトは毎回作り直す、
//   継続性は -c」という設計。これは 2026-08-11 に我々が辿り着いた結論
//   (「zellij の永続化に作業復元を期待する設計自体が誤り。復元源は常に
//   ~/.claude/projects/*.jsonl だけ」) と同じ。彼は最初からそう作っていた。
//   我々の config.kdl の session_serialization true も 2026-08-13 に外した。
//
// ■ claude は claude-zellij ラッパー経由
//
//   これが無いと 🤖 / ✅ のタブ名切り替えフックが動かない (フックは
//   /tmp/zellij-tab-name-<paneid> を読むが、書くのはこのラッパーだけ。
//   旧レイアウトは `command "claude"` 直呼びで、導入以来ずっと無効だった)。
//
// ■ 起動
//
//   `zellij --layout work`。端末を開いただけでは立ち上がらない (auto-start は
//   上流と同じく素の zellij で、レイアウトは手で開く)。
// ============================================================================

layout {
    cwd "/Users/takuyamatsumoto"

    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }


    tab name="Frank" focus=true hide_floating_panes=true {
        pane stacked=true {
            pane command="claude-zellij" cwd="Atrae/frank" expanded=true {
                args "Frank" "-c"
                start_suspended true
            }
            pane name="frank.main :8080" command="bash" cwd="Atrae/frank" {
                args "-c" "source .venv/bin/activate && exec python -m frank.main"
                start_suspended true
            }
        }
    }

    tab name="tiki-taka" hide_floating_panes=true {
        pane command="claude-zellij" cwd="LightSuccess" {
            args "tiki-taka" "-c"
            start_suspended true
        }
    }

    tab name="Forms" hide_floating_panes=true {
        pane stacked=true {
            pane command="claude-zellij" cwd="Atrae/wevox-mono-web/web-progressive" expanded=true {
                args "Forms" "-c"
                start_suspended true
            }
            pane name="BFF :3333" command="pnpm" cwd="Atrae/wevox-rest-bff/apps/wevox-bff" {
                args "dev"
                start_suspended true
            }
            pane name="forms :3017" command="pnpm" cwd="Atrae/wevox-mono-web/web-progressive" {
                args "dev" "--filter" "forms"
                start_suspended true
            }
        }
    }

    tab name="uSketch" hide_floating_panes=true {
        pane stacked=true {
            pane command="claude-zellij" cwd="Atrae/usketch" expanded=true {
                args "uSketch" "-c"
                start_suspended true
            }
            pane name="dev (turbo)" command="pnpm" cwd="Atrae/usketch" {
                args "dev"
                start_suspended true
            }
        }
    }


    tab name="brain" hide_floating_panes=true {
        pane command="claude-zellij" cwd="brain" {
            args "brain" "-c"
            start_suspended true
        }
    }

    tab name="dotfiles" hide_floating_panes=true {
        pane command="claude-zellij" cwd="dotfiles" {
            args "dotfiles" "-c"
            start_suspended true
        }
    }

    new_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        pane
    }
}

// General - PJ非依存の司令塔 / 雑用タブ
//   起動: zj-project general
//
// ┌──────────────────────┬────────────┐
// │ lead (claude, 65%)   │ shell      │
// └──────────────────────┴────────────┘
//
// ★ lead は start_suspended。Enter を押した時点の最新セッションを resume する。
//   詳細は frank.kdl 冒頭の設計メモを参照 (このディレクトリの正典)。
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }
    tab name="General" {
        pane split_direction="vertical" {
            pane name="lead" focus=true size="65%" cwd="/Users/takuyamatsumoto" {
                command "claude-resume-latest"
                args "--tab" "General" "/Users/takuyamatsumoto"
                start_suspended true
            }
            pane name="shell" size="35%" cwd="/Users/takuyamatsumoto"
        }
    }
}
